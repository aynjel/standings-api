# Development Dockerfile with Go tools included
# Use this for development when you need to run `go get`, etc inside the container

FROM golang:1.21.6-alpine

# Install build dependencies
RUN apk add --no-cache git make ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies and ensure go.sum is up to date
RUN go mod download && go mod tidy

# Install swag for API documentation
RUN go install github.com/swaggo/swag/cmd/swag@latest

# Copy source code
COPY . .

# Copy and set up entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port
EXPOSE 4300

# Use entrypoint to generate docs on startup
ENTRYPOINT ["/entrypoint.sh"]
CMD ["go", "run", "main.go"]
