# Docker Environment Configuration Example
# Copy this file to create your .env file for Docker usage

# Server Configuration
PORT=4300
SECRET_KEY=docker-secret-key-change-in-production

# Development Environment (SQLite)
APP_ENV=development
SQLITE_IN_MEMORY=false
SQLITE_DB_PATH=./database/standings_dev.db

# Production Environment (PostgreSQL)
# Uncomment these to use PostgreSQL instead of SQLite
# APP_ENV=production
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tabulation_db

# PostgreSQL Configuration (if using postgres service)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tabulation_db
DB_PORT=5432
